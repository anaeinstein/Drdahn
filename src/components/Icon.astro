---
import icons from '../data/icons.json';
interface Props { name: keyof typeof icons; label?: string }
const { name, label } = Astro.props;
const i = icons[name];
---
<svg viewBox={`0 0 ${i.w} ${i.h}`} aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label}><path d={i.d} /></svg>
